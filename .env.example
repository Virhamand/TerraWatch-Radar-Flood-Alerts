# Copy to .env (never commit .env)

# NASA Earthdata Login - required to read NISAR data from ASF DAAC
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# api.nasa.gov key (optional; EONET works without it)
NASA_API_KEY=

# OpenAI-compatible LLM endpoint for briefings (Groq free tier by default)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
